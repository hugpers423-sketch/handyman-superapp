{
  "name": "handyman-superapp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:client": "vite --config vite.config.client.ts",
    "dev:pro": "vite --config vite.config.pro.ts",
    "dev:staff": "vite --config vite.config.staff.ts",
    "dev:admin": "vite --config vite.config.admin.ts",
    "build": "npm run build:all",
    "build:all": "npm run build:client && npm run build:pro && npm run build:staff && npm run build:admin",
    "build:client": "tsc && vite build --config vite.config.client.ts",
    "build:pro": "tsc && vite build --config vite.config.pro.ts",
    "build:staff": "tsc && vite build --config vite.config.staff.ts",
    "build:admin": "tsc && vite build --config vite.config.admin.ts",
    "preview": "vite preview",
    "preview:client": "vite preview --outDir dist/client",
    "preview:pro": "vite preview --outDir dist/pro",
    "preview:staff": "vite preview --outDir dist/staff",
    "preview:admin": "vite preview --outDir dist/admin",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "cap:sync": "npx cap sync",
    "cap:sync:client": "npx cap sync android && npx cap sync ios",
    "cap:build:android": "npm run build:client && npm run build:pro && npm run build:staff && npx cap sync android && cd android && ./gradlew bundleRelease",
    "cap:build:ios": "npm run build:client && npm run build:pro && npm run build:staff && npx cap sync ios && cd ios/App && xcodebuild -workspace App.xcworkspace -scheme App -configuration Release -archivePath App.xcarchive archive",
    "generate:icons": "node scripts/generate-icons.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.7",
    "@types/leaflet": "^1.9.22",
    "@types/qrcode": "^1.5.6",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "playwright": "^1.63.0",
    "preact": "^10.29.8",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/camera": "^8.2.4",
    "@capacitor/cli": "^8.4.3",
    "@capacitor/core": "^8.5.2",
    "@capacitor/device": "^8.0.3",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "leaflet": "^1.9.4",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "recharts": "^3.10.1",
    "socket.io-client": "^4.8.3"
  }
}
