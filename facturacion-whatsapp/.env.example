# App
APP_NAME="Facturación WhatsApp Bot"
DEBUG=True
API_V1_PREFIX="/api/v1"

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/facturacion
REDIS_URL=redis://localhost:6379/0

# WhatsApp (Meta Cloud API)
WHATSAPP_PROVIDER=meta
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_access_token
WHATSAPP_VERIFY_TOKEN=facturacion_bot_verify_2024
WHATSAPP_APP_SECRET=your_app_secret
WHATSAPP_WEBHOOK_URL=https://your-domain.com/api/v1/webhook

# Nubefact
NUBEFACT_API_URL=https://api.nubefact.com/api/v1
NUBEFACT_TOKEN=your_nubefact_token
NUBEFACT_RUC=your_ruc
NUBEFACT_USER=your_user
NUBEFACT_PASSWORD=your_password
NUBEFACT_SANDBOX=True

# Whisper (local)
WHISPER_MODEL=base
WHISPER_DEVICE=cpu

# Product Recognition (CLIP)
CLIP_MODEL=openai/clip-vit-base-patch32
PRODUCT_SIMILARITY_THRESHOLD=0.82
MAX_PRODUCT_IMAGES=5

# OCR
OCR_LANGUAGES=["spa", "eng"]

# Security
SECRET_KEY=change-me-in-production-very-long-secret-key-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Ngrok (para desarrollo)
NGROK_AUTHTOKEN=your_ngrok_token